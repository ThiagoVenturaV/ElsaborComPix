# Backend secrets (required; never commit real values)
MERCADO_PAGO_ACCESS_TOKEN=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Comma-separated frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional public HTTPS endpoint registered in Mercado Pago
MERCADO_PAGO_WEBHOOK_URL=

PORT=3001

# Optional override for tests or persistent storage mounts
DATA_DIR=
